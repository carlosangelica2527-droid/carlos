{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quipu-ats",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quipu-db",
      "database_id": "9d0f287f-523a-47f3-83f1-04d951c6c56d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "carlos1233"
    }
  ]
}
